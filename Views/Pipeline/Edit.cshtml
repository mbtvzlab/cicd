@model CiCd.ViewModels.PipelineEditModel
@using CiCd.Models
@{
    ViewData["Title"] = "Edit Pipeline";
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();
}

<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Dashboard</a>
    <span class="breadcrumb-separator">/</span>
    <a href="@Url.Action("Index", "Pipeline")">Pipelines</a>
    <span class="breadcrumb-separator">/</span>
    <span class="breadcrumb-current">Edit @Model.Name</span>
</div>

<h2>Edit Pipeline &mdash; @Model.Name</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Branch"></label>
                <input asp-for="Branch" class="form-control" />
                <span asp-validation-for="Branch" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProjectId">Project</label>
                <select asp-for="ProjectId" class="form-control">
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id" selected="@(project.Id == Model.ProjectId)">@project.Name</option>
                    }
                </select>
                <span asp-validation-for="ProjectId" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsEnabled">
                    <input asp-for="IsEnabled" type="checkbox" /> Enabled
                </label>
            </div>
            <div style="margin-top: 16px; display: flex; gap: 8px;">
                <button type="submit" class="btn btn-primary">Save</button>
                <a href="@Url.Action("Index", "Pipeline")" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>