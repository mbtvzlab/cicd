@model List<CiCd.Models.Pipeline>
@using CiCd.Models
@{
    ViewData["Title"] = "Pipelines";
}

<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Dashboard</a>
    <span class="breadcrumb-separator">/</span>
    <span class="breadcrumb-current">Pipelines</span>
</div>

<div class="section-header">
    <h2>Pipelines</h2>
    <a href="@Url.Action("Create", "Pipeline")" class="btn btn-primary">+ New Pipeline</a>
</div>

<div class="search-bar">
    <div class="search-wrapper">
        <span class="search-icon">&#128269;</span>
        <input type="text" class="search-input" id="search-input" placeholder="Search pipelines..." />
    </div>
</div>

<div class="table-container fade-in" id="results-container">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Project</th>
                <th>Branch</th>
                <th>Status</th>
                <th>Steps</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="results-body">
            @foreach (var pipeline in Model)
            {
                <tr class="row-highlight">
                    <td>#@pipeline.Id</td>
                    <td><a href="@Url.Action("Details", new { id = pipeline.Id })">@pipeline.Name</a></td>
                    <td>@pipeline.Project?.Name</td>
                    <td class="text-secondary">@pipeline.Branch</td>
                    <td>
                        @if (pipeline.IsEnabled)
                        {
                            <span class="badge badge-success"><span class="badge-dot"></span> Enabled</span>
                        }
                        else
                        {
                            <span class="badge badge-cancelled"><span class="badge-dot"></span> Disabled</span>
                        }
                    </td>
                    <td>@pipeline.Steps?.Count</td>
                    <td class="text-secondary">@pipeline.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td class="actions-cell">
                        <a href="@Url.Action("Steps", new { id = pipeline.Id })" class="btn btn-secondary btn-sm">Steps</a>
                        <a href="@Url.Action("Edit", new { id = pipeline.Id })" class="btn btn-secondary btn-sm">Edit</a>
                        <form asp-action="Delete" asp-route-id="@pipeline.Id" method="post" class="delete-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm" data-confirm="Are you sure you want to delete this pipeline?">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="loading-overlay" id="loading-overlay">
        <div class="spinner"></div>
    </div>
</div>

@section Scripts {
<script>
$(function(){
    var timer;
    $('#search-input').on('input', function(){
        clearTimeout(timer);
        var q = $(this).val();
        timer = setTimeout(function(){
            var overlay = $('#loading-overlay');
            overlay.addClass('visible');
            $.ajax({
                url: '@Url.Action("Index", "Pipeline")',
                data: { search: q },
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(data){
                    var body = $('#results-body');
                    body.empty();
                    if(data.length === 0){
                        body.append('<tr><td colspan="8" style="text-align:center;color:var(--text-muted);">No pipelines found</td></tr>');
                    } else {
                        data.forEach(function(p){
                            var statusBadge = p.isEnabled
                                ? '<span class="badge badge-success"><span class="badge-dot"></span> Enabled</span>'
                                : '<span class="badge badge-cancelled"><span class="badge-dot"></span> Disabled</span>';
                            body.append(
                                '<tr class="fade-in">' +
                                '<td>#' + p.id + '</td>' +
                                '<td><a href="/pipelines/' + p.id + '">' + p.name + '</a></td>' +
                                '<td>' + (p.project || '') + '</td>' +
                                '<td class="text-secondary">' + p.branch + '</td>' +
                                '<td>' + statusBadge + '</td>' +
                                '<td>' + p.steps + '</td>' +
                                '<td class="text-secondary">' + p.createdAt + '</td>' +
                                '<td class="actions-cell">' +
                                    '<a href="/pipelines/' + p.id + '/steps" class="btn btn-secondary btn-sm">Steps</a> ' +
                                    '<a href="/pipelines/' + p.id + '/edit" class="btn btn-secondary btn-sm">Edit</a> ' +
                                    '<form action="/pipelines/' + p.id + '/delete" method="post" class="delete-form">' +
                                    '<button type="submit" class="btn btn-danger btn-sm" data-confirm="Are you sure?">Delete</button></form>' +
                                '</td></tr>'
                            );
                        });
                    }
                    overlay.removeClass('visible');
                },
                error: function(){ overlay.removeClass('visible'); }
            });
        }, 300);
    });
});
</script>
}