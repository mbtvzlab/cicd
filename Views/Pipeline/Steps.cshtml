@model CiCd.Models.Pipeline
@{
    ViewData["Title"] = $"Pipeline Steps: {Model.Name}";
}

<nav class="breadcrumb">
    <a href="@Url.Action("Index", "Pipeline")">Pipelines</a>
    <span class="breadcrumb-separator">/</span>
    <a href="@Url.Action("Details", new { id = Model.Id })">@Model.Name</a>
    <span class="breadcrumb-separator">/</span>
    <span class="breadcrumb-current">Steps</span>
</nav>

<div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
    <h2 style="margin: 0;">@Model.Name Steps</h2>
    <div style="margin-left: auto; display: flex; gap: 8px;">
        <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-secondary btn-sm">Back to Pipeline</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h3>Steps (@Model.Steps?.Count)</h3>
        @if (Model.Steps?.Any() == true)
        {
            <div style="margin-top: 16px;">
                @foreach (var step in Model.Steps.OrderBy(s => s.Order))
                {
                    <div id="step-@step.Order" class="step-card" style="margin-bottom: 16px; border: 1px solid var(--border); border-radius: 4px; overflow: hidden;">
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--bg-tertiary); border-bottom: 1px solid var(--border);">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span class="text-secondary">#@step.Order</span>
                                <span style="font-weight: 500;">@step.Name</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span class="text-secondary" style="font-size: 12px;">Timeout: @step.TimeoutSeconds s</span>
                                @if (step.ContinueOnError)
                                {
                                    <span class="badge badge-pending" style="font-size: 11px;">Continue on error</span>
                                }
                            </div>
                        </div>
                        <div style="background: #0d0d0d; padding: 16px;">
                            <pre style="margin: 0; color: #d4d4d4; font-family: 'Consolas', 'Monaco', 'Courier New', monospace; font-size: 13px; line-height: 1.5; white-space: pre-wrap; word-break: break-all;">@step.Command</pre>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted" style="margin-top: 12px;">No steps configured</p>
        }
    </div>
</div>
