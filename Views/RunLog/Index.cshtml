@model List<CiCd.Models.RunLog>
@using CiCd.Models
@{
    ViewData["Title"] = "Runs";
}

<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Dashboard</a>
    <span class="breadcrumb-separator">/</span>
    <span class="breadcrumb-current">Runs</span>
</div>

<h2>Runs</h2>

<div class="search-bar">
    <div class="search-wrapper">
        <span class="search-icon">&#128269;</span>
        <input type="text" class="search-input" id="search-input" placeholder="Search runs by pipeline, user, or status..." />
    </div>
</div>

<div class="table-container fade-in" id="results-container">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Pipeline</th>
                <th>Status</th>
                <th>Triggered By</th>
                <th>Trigger</th>
                <th>Started</th>
                <th>Duration</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="results-body">
            @foreach (var run in Model)
            {
                <tr class="row-highlight">
                    <td><a href="@Url.Action("Details", new { id = run.Id })">#@run.Id</a></td>
                    <td>@run.Pipeline?.Name</td>
                    <td>
                        @switch (run.Status)
                        {
                            case RunStatus.Success:
                                <span class="badge badge-success"><span class="badge-dot"></span> Success</span>
                                break;
                            case RunStatus.Failed:
                                <span class="badge badge-failed"><span class="badge-dot"></span> Failed</span>
                                break;
                            case RunStatus.Running:
                                <span class="badge badge-running"><span class="badge-dot"></span> Running</span>
                                break;
                            case RunStatus.Cancelled:
                                <span class="badge badge-cancelled"><span class="badge-dot"></span> Cancelled</span>
                                break;
                            default:
                                <span class="badge badge-pending">@run.Status</span>
                                break;
                        }
                    </td>
                    <td>@run.TriggeredBy?.Username</td>
                    <td class="text-secondary">@run.TriggerType</td>
                    <td class="text-secondary">@run.StartedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (run.Duration.HasValue)
                        {
                            <span>@run.Duration.Value.TotalMinutes.ToString("F1") min</span>
                        }
                        else
                        {
                            <span class="text-secondary">-</span>
                        }
                    </td>
                    <td class="actions-cell">
                        <a href="@Url.Action("Edit", new { id = run.Id })" class="btn btn-secondary btn-sm">Edit</a>
                        <form asp-action="Delete" asp-route-id="@run.Id" method="post" class="delete-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm" data-confirm="Are you sure you want to delete this run?">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="loading-overlay" id="loading-overlay">
        <div class="spinner"></div>
    </div>
</div>

@section Scripts {
<script>
$(function(){
    var timer;
    $('#search-input').on('input', function(){
        clearTimeout(timer);
        var q = $(this).val();
        timer = setTimeout(function(){
            var overlay = $('#loading-overlay');
            overlay.addClass('visible');
            $.ajax({
                url: '@Url.Action("Index", "RunLog")',
                data: { search: q },
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(data){
                    var body = $('#results-body');
                    body.empty();
                    if(data.length === 0){
                        body.append('<tr><td colspan="8" style="text-align:center;color:var(--text-muted);">No runs found</td></tr>');
                    } else {
                        data.forEach(function(r){
                            body.append(
                                '<tr class="fade-in">' +
                                '<td><a href="/runs/' + r.id + '">#' + r.id + '</a></td>' +
                                '<td>' + (r.pipeline || '') + '</td>' +
                                '<td><span class="badge badge-' + r.status.toLowerCase() + '">' + r.status + '</span></td>' +
                                '<td>' + (r.triggeredBy || '') + '</td>' +
                                '<td class="text-secondary">' + r.triggerType + '</td>' +
                                '<td class="text-secondary">' + r.startedAt + '</td>' +
                                '<td>' + (r.duration || '-') + '</td>' +
                                '<td class="actions-cell">' +
                                    '<a href="/runs/' + r.id + '/edit" class="btn btn-secondary btn-sm">Edit</a> ' +
                                    '<form action="/runs/' + r.id + '/delete" method="post" class="delete-form">' +
                                    '<button type="submit" class="btn btn-danger btn-sm" data-confirm="Are you sure?">Delete</button></form>' +
                                '</td></tr>'
                            );
                        });
                    }
                    overlay.removeClass('visible');
                },
                error: function(){ overlay.removeClass('visible'); }
            });
        }, 300);
    });
});
</script>
}