@model CiCd.ViewModels.RunLogEditModel
@using CiCd.Models
@{
    ViewData["Title"] = "Edit Run #" + Model.Id;
    var pipelines = ViewBag.Pipelines as List<Pipeline> ?? new List<Pipeline>();
    var users = ViewBag.Users as List<User> ?? new List<User>();
}

<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Dashboard</a>
    <span class="breadcrumb-separator">/</span>
    <a href="@Url.Action("Index", "RunLog")">Runs</a>
    <span class="breadcrumb-separator">/</span>
    <span class="breadcrumb-current">Edit Run #@Model.Id</span>
</div>

<h2>Edit Run #@Model.Id</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="PipelineId">Pipeline</label>
                <select asp-for="PipelineId" class="form-control">
                    @foreach (var pipeline in pipelines)
                    {
                        <option value="@pipeline.Id" selected="@(pipeline.Id == Model.PipelineId)">@pipeline.Name</option>
                    }
                </select>
                <span asp-validation-for="PipelineId" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="TriggeredByUserId">Triggered By</label>
                <select asp-for="TriggeredByUserId" class="form-control">
                    @foreach (var user in users)
                    {
                        <option value="@user.Id" selected="@(user.Id == Model.TriggeredByUserId)">@user.Username</option>
                    }
                </select>
                <span asp-validation-for="TriggeredByUserId" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<RunStatus>()" class="form-control"></select>
                <span asp-validation-for="Status" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="TriggerType"></label>
                <select asp-for="TriggerType" asp-items="Html.GetEnumSelectList<TriggerType>()" class="form-control"></select>
                <span asp-validation-for="TriggerType" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartedAt"></label>
                <input asp-for="StartedAt" class="form-control datetime-picker" />
                <span asp-validation-for="StartedAt" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="FinishedAt"></label>
                <input asp-for="FinishedAt" class="form-control datetime-picker" />
                <span asp-validation-for="FinishedAt" class="validation-error"></span>
            </div>
            <div style="margin-top: 16px; display: flex; gap: 8px;">
                <button type="submit" class="btn btn-primary">Save</button>
                <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
$(function(){
    $('.datetime-picker').each(function(){
        $(this).flatpickr({
            enableTime: true,
            dateFormat: 'Y-m-d H:i',
            time_24hr: true,
            theme: 'dark'
        });
    });
});
</script>
}