@using CiCd.Models
@model CiCd.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-value">@Model.TotalRuns</div>
        <div class="stat-label">Total Runs</div>
    </div>
    <div class="stat-card">
        <div class="stat-value success">@Model.Passed24h</div>
        <div class="stat-label">Passed (24h)</div>
    </div>
    <div class="stat-card">
        <div class="stat-value failed">@Model.Failed24h</div>
        <div class="stat-label">Failed (24h)</div>
    </div>
    <div class="stat-card">
        <div class="stat-value running">@Model.RunningNow</div>
        <div class="stat-label">Running Now</div>
    </div>
</div>

<div class="section">
    <div class="section-header">
        <h2>Recent Runs</h2>
        <a href="@Url.Action("Index", "RunLog")" class="btn btn-secondary">View All</a>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Pipeline</th>
                    <th>Project</th>
                    <th>Trigger</th>
                    <th>Started</th>
                    <th>Duration</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in Model.RecentRuns)
                {
                    var badgeClass = run.Status switch
                    {
                        RunStatus.Success => "badge-success",
                        RunStatus.Failed => "badge-failed",
                        RunStatus.Running => "badge-running",
                        RunStatus.Cancelled => "badge-cancelled",
                        _ => ""
                    };
                    var displayStatus = run.Status.ToString();
                    var triggerDisplay = run.TriggerType == TriggerType.Push
                        ? $"push:{run.Pipeline.Branch ?? run.Pipeline.Name.ToLowerInvariant()}"
                        : run.TriggerType.ToString().ToLower();

                    <tr>
                        <td><span class="badge @badgeClass"><span class="badge-dot"></span> @displayStatus</span></td>
                        <td><a href="@Url.Action("Details", "Pipeline", new { id = run.Pipeline.Id })">@run.Pipeline.Name</a></td>
                        <td>@(run.Pipeline.Project?.Name ?? "—")</td>
                        <td><span class="text-secondary">@triggerDisplay</span></td>
                        <td>@run.StartedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(run.Duration.HasValue ? $"{(int)run.Duration.Value.TotalMinutes}m {(int)run.Duration.Value.Seconds}s" : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="section">
    <div class="section-header">
        <h2>Projects Overview</h2>
        <a href="@Url.Action("Index", "Project")" class="btn btn-secondary">View All</a>
    </div>
    <div class="details-grid">
        <div class="card">
            <div class="card-body">
                <div class="info-row">
                    <span class="info-label">Total Projects</span>
                    <span class="info-value">@Model.TotalProjects</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Active</span>
                    <span class="info-value" style="color: var(--success);">@Model.ActiveProjects</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Inactive</span>
                    <span class="info-value" style="color: var(--text-muted);">@Model.InactiveProjects</span>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="info-row">
                    <span class="info-label">Total Pipelines</span>
                    <span class="info-value">@Model.TotalPipelines</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Enabled</span>
                    <span class="info-value" style="color: var(--success);">@Model.EnabledPipelines</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Disabled</span>
                    <span class="info-value" style="color: var(--text-muted);">@Model.DisabledPipelines</span>
                </div>
            </div>
        </div>
    </div>
</div>