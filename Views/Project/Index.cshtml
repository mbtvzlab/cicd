@model List<CiCd.Models.Project>
@using CiCd.Models
@{
    ViewData["Title"] = "Projects";
}

<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Dashboard</a>
    <span class="breadcrumb-separator">/</span>
    <span class="breadcrumb-current">Projects</span>
</div>

<div class="section-header">
    <h2>Projects</h2>
    <a href="@Url.Action("Create", "Project")" class="btn btn-primary">+ New Project</a>
</div>

<div class="search-bar">
    <div class="search-wrapper">
        <span class="search-icon">&#128269;</span>
        <input type="text" class="search-input" id="search-input" placeholder="Search projects..." />
    </div>
</div>

<div class="table-container fade-in" id="results-container">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Owner</th>
                <th>Members</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="results-body">
            @foreach (var project in Model)
            {
                <tr class="row-highlight">
                    <td>#@project.Id</td>
                    <td><a href="@Url.Action("Details", new { id = project.Id })">@project.Name</a></td>
                    <td><span class="text-secondary">@project.Description</span></td>
                    <td>
                        @if (project.IsActive)
                        {
                            <span class="badge badge-success"><span class="badge-dot"></span> Active</span>
                        }
                        else
                        {
                            <span class="badge badge-cancelled"><span class="badge-dot"></span> Inactive</span>
                        }
                    </td>
                    <td>@project.Owner?.Username</td>
                    <td>@project.Members?.Count</td>
                    <td class="text-secondary">@project.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td class="actions-cell">
                        <a href="@Url.Action("Edit", new { id = project.Id })" class="btn btn-secondary btn-sm">Edit</a>
                        <form asp-action="Delete" asp-route-id="@project.Id" method="post" class="delete-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm" data-confirm="Are you sure you want to delete this project?">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="loading-overlay" id="loading-overlay">
        <div class="spinner"></div>
    </div>
</div>

@section Scripts {
<script>
$(function(){
    var timer;
    $('#search-input').on('input', function(){
        clearTimeout(timer);
        var q = $(this).val();
        timer = setTimeout(function(){
            var overlay = $('#loading-overlay');
            overlay.addClass('visible');
            $.ajax({
                url: '@Url.Action("Index", "Project")',
                data: { search: q },
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(data){
                    var body = $('#results-body');
                    body.empty();
                    if(data.length === 0){
                        body.append('<tr><td colspan="8" style="text-align:center;color:var(--text-muted);">No projects found</td></tr>');
                    } else {
                        data.forEach(function(p){
                            var statusBadge = p.isActive
                                ? '<span class="badge badge-success"><span class="badge-dot"></span> Active</span>'
                                : '<span class="badge badge-cancelled"><span class="badge-dot"></span> Inactive</span>';
                            body.append(
                                '<tr class="fade-in">' +
                                '<td>#' + p.id + '</td>' +
                                '<td><a href="/Project/Details/' + p.id + '">' + p.name + '</a></td>' +
                                '<td><span class="text-secondary">' + (p.description || '') + '</span></td>' +
                                '<td>' + statusBadge + '</td>' +
                                '<td>' + (p.owner || '') + '</td>' +
                                '<td>' + p.members + '</td>' +
                                '<td class="text-secondary">' + p.createdAt + '</td>' +
                                '<td class="actions-cell">' +
                                    '<a href="/Project/Edit/' + p.id + '" class="btn btn-secondary btn-sm">Edit</a> ' +
                                    '<form action="/Project/Delete/' + p.id + '" method="post" class="delete-form">' +
                                    '<button type="submit" class="btn btn-danger btn-sm" data-confirm="Are you sure?">Delete</button></form>' +
                                '</td></tr>'
                            );
                        });
                    }
                    overlay.removeClass('visible');
                },
                error: function(){ overlay.removeClass('visible'); }
            });
        }, 300);
    });
});
</script>
}