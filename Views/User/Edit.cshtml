@model User
@using CiCd.Models
@{
    ViewData["Title"] = "Edit User";
}

<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Dashboard</a>
    <span class="breadcrumb-separator">/</span>
    <a href="@Url.Action("Index", "User")">Users</a>
    <span class="breadcrumb-separator">/</span>
    <span class="breadcrumb-current">Edit @Model.Username</span>
</div>

<h2>Edit User &mdash; @Model.Username</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            @await Html.PartialAsync("_UserForm", Model)
            <div style="margin-top: 16px; display: flex; gap: 8px;">
                <button type="submit" class="btn btn-primary">Save</button>
                <a href="@Url.Action("Index", "User")" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>