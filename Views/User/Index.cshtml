@model IEnumerable<User>
@using CiCd.Models
@{
    ViewData["Title"] = "Users";
}

<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Dashboard</a>
    <span class="breadcrumb-separator">/</span>
    <span class="breadcrumb-current">Users</span>
</div>

<div class="section-header">
    <h2>Users</h2>
    <a href="@Url.Action("Create", "User")" class="btn btn-primary">+ New User</a>
</div>

<div class="search-bar">
    <div class="search-wrapper">
        <span class="search-icon">&#128269;</span>
        <input type="text" class="search-input" id="search-input" placeholder="Search users..." />
    </div>
</div>

<div class="table-container fade-in" id="results-container">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Joined</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="results-body">
            @foreach (var user in Model)
            {
                <tr class="row-highlight">
                    <td>@user.Id</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>
                        <span class="badge @(user.Role == UserRole.Admin ? "badge-success" : user.Role == UserRole.Developer ? "badge-running" : "badge-cancelled")">
                            @user.Role
                        </span>
                    </td>
                    <td class="text-secondary">@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td class="actions-cell">
                        <a href="@Url.Action("Edit", "User", new { id = user.Id })" class="btn btn-secondary btn-sm">Edit</a>
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="delete-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm" data-confirm="Are you sure you want to delete this user?">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="loading-overlay" id="loading-overlay">
        <div class="spinner"></div>
    </div>
</div>

@section Scripts {
<script>
$(function(){
    var timer;
    $('#search-input').on('input', function(){
        clearTimeout(timer);
        var q = $(this).val();
        timer = setTimeout(function(){
            var overlay = $('#loading-overlay');
            overlay.addClass('visible');
            $.ajax({
                url: '@Url.Action("Index", "User")',
                data: { search: q },
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(data){
                    var body = $('#results-body');
                    body.empty();
                    if(data.length === 0){
                        body.append('<tr><td colspan="6" style="text-align:center;color:var(--text-muted);">No users found</td></tr>');
                    } else {
                        data.forEach(function(u){
                            var roleBadge = u.role === 'Admin'
                                ? '<span class="badge badge-success">Admin</span>'
                                : u.role === 'Developer'
                                ? '<span class="badge badge-running">Developer</span>'
                                : '<span class="badge badge-cancelled">Viewer</span>';
                            body.append(
                                '<tr class="fade-in">' +
                                '<td>' + u.id + '</td>' +
                                '<td>' + u.username + '</td>' +
                                '<td>' + u.email + '</td>' +
                                '<td>' + roleBadge + '</td>' +
                                '<td class="text-secondary">' + u.createdAt + '</td>' +
                                '<td class="actions-cell">' +
                                    '<a href="/users/' + u.id + '/edit" class="btn btn-secondary btn-sm">Edit</a> ' +
                                    '<form action="/users/' + u.id + '/delete" method="post" class="delete-form">' +
                                    '<button type="submit" class="btn btn-danger btn-sm" data-confirm="Are you sure?">Delete</button></form>' +
                                '</td></tr>'
                            );
                        });
                    }
                    overlay.removeClass('visible');
                },
                error: function(){ overlay.removeClass('visible'); }
            });
        }, 300);
    });
});
</script>
}